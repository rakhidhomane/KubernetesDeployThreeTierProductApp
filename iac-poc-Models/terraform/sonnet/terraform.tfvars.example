# Example: terraform.tfvars
# Copy this file to terraform.tfvars and customize for your environment

###############################################################################
# General Configuration
###############################################################################

region       = "us-east-1"
project_name = "ec2-demo"
environment  = "dev"

###############################################################################
# EC2 Instance Configuration
###############################################################################

instance_name = "web-server"
instance_type = "t3.micro"

# Leave empty to use latest Amazon Linux 2023 AMI
ami_id = ""

# SSH key name (leave empty to disable SSH key-based access)
# Recommended: Use SSM Session Manager instead
key_name = ""

###############################################################################
# Network Configuration
###############################################################################

use_default_vpc = true

# SSH Access
allow_ssh = true
# IMPORTANT: Restrict to your IP in production!
ssh_allowed_cidr_blocks = ["203.0.113.0/32"] # Replace with your IP

# HTTP/HTTPS Access
allow_http               = true
http_allowed_cidr_blocks = ["0.0.0.0/0"]

allow_https               = true
https_allowed_cidr_blocks = ["0.0.0.0/0"]

###############################################################################
# Storage Configuration
###############################################################################

root_volume_type              = "gp3"
root_volume_size              = 20
delete_volume_on_termination  = true
enable_encryption             = true

###############################################################################
# Monitoring Configuration
###############################################################################

enable_detailed_monitoring = true
enable_cloudwatch_alarms   = true
cpu_alarm_threshold        = 80

# SNS topic ARNs for alarm notifications (optional)
# alarm_actions = ["arn:aws:sns:us-east-1:123456789012:my-alerts"]
alarm_actions = []

###############################################################################
# Additional Tags
###############################################################################

additional_tags = {
  Team  = "DevOps"
  Owner = "john.doe@example.com"
  CostCenter = "Engineering"
}
